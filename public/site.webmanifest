{
  "name": "PokéTier",
  "short_name": "PokéTier",
  "description": "Aplicativo de Tier List de Pokémon com mais de 1.200 Pokémon, Mega Evoluções, Gigantamax e Formas Regionais.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#121212",
  "theme_color": "#e06c75",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/favicon.png",
      "sizes": "64x64",
      "type": "image/png"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
